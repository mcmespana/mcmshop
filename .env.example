# Copia este fichero a .env y rellena los valores.
# El .env real NUNCA se sube al repositorio (está en .gitignore).

# Clave de la API de Holded. Se genera en Holded → Configuración → Desarrolladores.
# Para el portal en producción basta con permisos de LECTURA de productos y
# contactos, más ESCRITURA de contactos y pedidos de venta.
NUXT_HOLDED_API_KEY=

# Secreto para firmar la cookie de sesión (JWT). Cualquier cadena larga y aleatoria.
#   openssl rand -base64 48
NUXT_SESSION_SECRET=

# Credenciales de Google OAuth (consola de Google Cloud → Credenciales).
# URI de redirección autorizada: https://TU-DOMINIO/auth/google/callback
NUXT_GOOGLE_CLIENT_ID=
NUXT_GOOGLE_CLIENT_SECRET=

# Secreto que se añade a la URL del webhook de Holded para que nadie más pueda
# invalidar la caché del catálogo: https://TU-DOMINIO/api/webhooks/holded?clave=...
NUXT_WEBHOOK_SECRET=

# Almacén del que se lee el stock. Vacío = suma de todos los almacenes.
#   ECE Castellón: 63e1a26d17932443220d4e95
#   ECE Madrid:    677a68306cb5ce3b380b7496
NUXT_WAREHOUSE_ID=

# URL pública del portal, para los enlaces de los correos y el callback de Google.
NUXT_PUBLIC_SITE_URL=http://localhost:3000
